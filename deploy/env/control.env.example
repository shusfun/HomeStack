HOMESTACK_CONTROL_ADDR=0.0.0.0:8443
HOMESTACK_PUBLIC_URL=https://app.example.com:8443
HOMESTACK_HEADSCALE_URL=https://mesh.example.com
HOMESTACK_OIDC_ISSUER=https://id.example.com:8444
HOMESTACK_OIDC_CLIENT_ID=REPLACE_WITH_HOMESTACK_PUBLIC_CLIENT_ID
HOMESTACK_OIDC_ADMIN_GROUP=homestack-admins
HOMESTACK_STATE_DIR=/var/lib/homestack-control
HOMESTACK_HEADSCALE_CONFIG=/etc/headscale/config.yaml
HOMESTACK_TLS_CERT=/etc/homestack/tls/fullchain.pem
HOMESTACK_TLS_KEY=/etc/homestack/tls/privkey.pem
HOMESTACK_SIGNING_KEY=/etc/homestack/signing-private.key
HOMESTACK_SIGNING_KEY_ID=homestack-control-2026-01
