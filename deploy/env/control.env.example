HOMESTACK_CONTROL_TRANSPORT=reverse-proxy
HOMESTACK_CONTROL_ADDR=127.0.0.1:18443
HOMESTACK_PUBLIC_URL=https://home.example.com
HOMESTACK_STATE_DIR=/var/lib/homestack-control
HOMESTACK_SIGNING_KEY=/etc/homestack/control-signing.key
HOMESTACK_SIGNING_KEY_ID=homestack-control
HOMESTACK_GOOGLE_CLIENT_ID=
HOMESTACK_GOOGLE_CLIENT_SECRET=
HOMESTACK_GITHUB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
HOMESTACK_GITHUB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
