APP_URL=https://id.example.com:8444
HOST=0.0.0.0
PORT=8444
ACTORS_HOST=127.0.0.1
TLS_CERT=/etc/pocket-id/tls/fullchain.pem
TLS_KEY=/etc/pocket-id/tls/privkey.pem
ENCRYPTION_KEY_FILE=/etc/pocket-id/encryption-key
TRUST_PROXY=false
ALLOW_INSECURE_CALLBACK_URLS=true
VERSION_CHECK_DISABLED=true
ANALYTICS_DISABLED=true
DB_CONNECTION_STRING=/var/lib/pocket-id/pocket-id.db
UPLOAD_PATH=/var/lib/pocket-id/uploads
LOG_LEVEL=info
LOG_JSON=true
