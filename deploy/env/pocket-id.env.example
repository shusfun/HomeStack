APP_URL=https://id.example.com
INTERNAL_APP_URL=http://127.0.0.1:8444
HOST=127.0.0.1
PORT=8444
ACTORS_HOST=127.0.0.1
ENCRYPTION_KEY_FILE=/etc/pocket-id/encryption-key
TRUST_PROXY=127.0.0.1/32,::1/128
ALLOW_INSECURE_CALLBACK_URLS=false
VERSION_CHECK_DISABLED=true
ANALYTICS_DISABLED=true
DB_CONNECTION_STRING=/var/lib/pocket-id/pocket-id.db
UPLOAD_PATH=/var/lib/pocket-id/uploads
LOG_LEVEL=info
LOG_JSON=true
