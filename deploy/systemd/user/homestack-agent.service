[Unit]
Description=HomeStack device agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/homestack/agent.env
Environment=HOMESTACK_AGENT_TLS_CERT=%d/tls.crt
Environment=HOMESTACK_AGENT_TLS_KEY=%d/tls.key
LoadCredentialEncrypted=homestack-agent-profile
LoadCredentialEncrypted=tls.crt
LoadCredentialEncrypted=tls.key
ExecStart=%h/.local/bin/homestack-agent
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=%h/.local/state/homestack
ReadOnlyPaths=/run/homestack/helper.sock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
