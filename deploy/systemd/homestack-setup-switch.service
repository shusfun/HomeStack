[Unit]
Description=Switch HomeStack from setup to control
After=homestack-config-helper.service
Requires=homestack-config-helper.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/libexec/homestack-config-helper switch
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/etc/homestack /var/lib/homestack-setup
