[Unit]
Description=HomeStack one-time setup helper
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/homestack-setup/completed.json

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/homestack-setup-helper --uid=REPLACE_WITH_CONTROL_UID --socket=/run/homestack-setup/helper.sock
Restart=on-failure
RestartSec=5s
RuntimeDirectory=homestack-setup
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=homestack-setup
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/etc/homestack /etc/headscale /etc/pocket-id /etc/systemd/system /usr/local/bin /var/lib/homestack-setup /var/lib/headscale /var/lib/pocket-id

[Install]
WantedBy=multi-user.target
