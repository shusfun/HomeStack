[Unit]
Description=HomeStack restricted maintenance helper
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/homestack-setup/completed.json

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/homestack-setup-helper maintenance --uid=REPLACE_WITH_CONTROL_UID --socket=/run/homestack-maintenance/helper.sock
Restart=on-failure
RestartSec=5s
RuntimeDirectory=homestack-maintenance
RuntimeDirectoryMode=0755
StateDirectory=homestack-maintenance
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/etc/homestack /etc/headscale /etc/pocket-id /var/lib/homestack-maintenance /var/lib/homestack-setup

[Install]
WantedBy=multi-user.target
